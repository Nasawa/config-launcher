{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nasawa/config-launcher/schema/launcher-config.v1.schema.json",
  "title": "Config Launcher layout, schema version 1",
  "description": "The home screen of dev.nasawa.configlauncher. See ARCHITECTURE.md section 3. Unknown keys starting with 'x-' are preserved and ignored; any other unknown key is an error. Files over 2 MiB are refused (ARCHITECTURE.md section 17, Q16); x- values count toward that budget.",
  "type": "object",
  "required": [
    "schemaVersion",
    "pages"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": true
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "description": "Monotonic counter bumped by every writer (launcher or agent). Informational; conflicts are detected by content hash.",
      "type": "integer",
      "minimum": 0
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12,
          "default": 4
        },
        "rows": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12,
          "default": 5
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "dock": {
      "description": "Dock items in order, left to right.",
      "type": "array",
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/dockItem"
      }
    },
    "drawer": {
      "$ref": "#/$defs/drawer"
    },
    "elements": {
      "description": "Non-app elements (title bar first, widgets later): docs/design/title-bar.md. An element whose type this launcher doesn't know, or whose requires is above its feature level, is skipped with a warning and kept in the file.",
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "unsorted": {
      "description": "DEPRECATED, accepted and ignored in v1 (ARCHITECTURE.md section 18.5, AF-2): validated for type, never acted on, never written by the launcher. Unplaced apps always appear in the drawer. Removed in schema v2 with a migration.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "drawer",
            "page",
            "hidden"
          ],
          "default": "drawer",
          "deprecated": true
        },
        "pageTitle": {
          "type": "string",
          "maxLength": 40,
          "default": "Unsorted",
          "deprecated": true
        }
      },
      "deprecated": true
    }
  },
  "$defs": {
    "id": {
      "description": "Stable item ID, unique across the whole file. Generated once and never reused.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "packageName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+$",
      "maxLength": 256
    },
    "className": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.$]+$",
      "maxLength": 256
    },
    "profile": {
      "description": "Which user profile the target lives in. 'work' is only written when the user opts in. Private-space apps are never written (ARCHITECTURE.md section 15, OQ-31).",
      "enum": [
        "personal",
        "work"
      ],
      "default": "personal"
    },
    "label": {
      "type": "string",
      "maxLength": 60
    },
    "app": {
      "type": "object",
      "required": [
        "id",
        "type",
        "package"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "app"
        },
        "package": {
          "$ref": "#/$defs/packageName"
        },
        "activity": {
          "$ref": "#/$defs/className",
          "description": "Optional. Omit to use the package's default launcher activity."
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 40
          },
          "uniqueItems": true,
          "maxItems": 16
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11,
          "description": "Column. Required on page items; forbidden in folders and the dock."
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11,
          "description": "Row. Required on page items; forbidden in folders and the dock."
        }
      }
    },
    "shortcut": {
      "type": "object",
      "required": [
        "id",
        "type",
        "package",
        "shortcutId"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "shortcut"
        },
        "package": {
          "$ref": "#/$defs/packageName"
        },
        "shortcutId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11,
          "description": "Column. Required on page items; forbidden in folders and the dock."
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11,
          "description": "Row. Required on page items; forbidden in folders and the dock."
        }
      }
    },
    "folder": {
      "type": "object",
      "required": [
        "id",
        "type",
        "items"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "folder"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "items": {
          "description": "Folders hold apps and shortcuts only; no nested folders in v1.",
          "type": "array",
          "maxItems": 48,
          "items": {
            "allOf": [
              {
                "oneOf": [
                  {
                    "$ref": "#/$defs/app"
                  },
                  {
                    "$ref": "#/$defs/shortcut"
                  }
                ]
              }
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "x"
                  ]
                },
                {
                  "required": [
                    "y"
                  ]
                }
              ]
            }
          }
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11,
          "description": "Column. Required on page items; forbidden in folders and the dock."
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11,
          "description": "Row. Required on page items; forbidden in folders and the dock."
        }
      }
    },
    "leaf": {
      "oneOf": [
        {
          "$ref": "#/$defs/app"
        },
        {
          "$ref": "#/$defs/shortcut"
        },
        {
          "$ref": "#/$defs/folder"
        }
      ]
    },
    "gridItem": {
      "allOf": [
        {
          "$ref": "#/$defs/leaf"
        }
      ],
      "required": [
        "x",
        "y"
      ]
    },
    "dockItem": {
      "allOf": [
        {
          "$ref": "#/$defs/leaf"
        }
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "x"
            ]
          },
          {
            "required": [
              "y"
            ]
          }
        ]
      }
    },
    "page": {
      "type": "object",
      "required": [
        "id",
        "items"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 40
        },
        "items": {
          "type": "array",
          "maxItems": 144,
          "items": {
            "$ref": "#/$defs/gridItem"
          }
        },
        "overrides": {
          "$ref": "#/$defs/pageOverrides"
        }
      }
    },
    "drawerRule": {
      "type": "object",
      "required": [
        "id",
        "match",
        "group"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "match": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "packages": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/packageName"
              }
            },
            "packagePrefix": {
              "type": "string",
              "maxLength": 256
            },
            "tag": {
              "type": "string",
              "maxLength": 40
            },
            "category": {
              "enum": [
                "game",
                "audio",
                "video",
                "image",
                "social",
                "news",
                "maps",
                "productivity",
                "accessibility",
                "undefined"
              ]
            }
          }
        }
      }
    },
    "drawer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sort": {
          "enum": [
            "label",
            "installTime"
          ],
          "default": "label"
        },
        "hidden": {
          "description": "Apps never shown in the drawer or Unsorted (they still launch if placed explicitly).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/packageName"
          },
          "uniqueItems": true
        },
        "rules": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/drawerRule"
          }
        }
      }
    },
    "element": {
      "description": "Common element fields, checked for every element (docs/design/title-bar.md §3, docs/research/widgets.md §5.1). An element is anchored (anchor) or grid-placed (page, x, y, w, h), never both; a grid-placed element reserves its cells even when this launcher skips it. No additionalProperties here: an unknown type accepts any other keys (skipped, kept verbatim); each known type's own definition is strict. Known types (feature level 4): titleBar (level 2) and card (level 4); level 3 is reserved for appWidget.",
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,31}$"
        },
        "requires": {
          "description": "Launcher feature level this element needs. Above the launcher's level: skipped with a warning.",
          "type": "integer",
          "minimum": 1
        },
        "anchor": {
          "type": "string",
          "maxLength": 32
        },
        "page": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "h": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      },
      "dependentRequired": {
        "page": [
          "x",
          "y",
          "w",
          "h"
        ],
        "x": [
          "page",
          "y",
          "w",
          "h"
        ],
        "y": [
          "page",
          "x",
          "w",
          "h"
        ],
        "w": [
          "page",
          "x",
          "y",
          "h"
        ],
        "h": [
          "page",
          "x",
          "y",
          "w"
        ]
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "anchor",
              "page"
            ]
          },
          {
            "required": [
              "anchor",
              "x"
            ]
          },
          {
            "required": [
              "anchor",
              "y"
            ]
          },
          {
            "required": [
              "anchor",
              "w"
            ]
          },
          {
            "required": [
              "anchor",
              "h"
            ]
          }
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "titleBar"
              },
              "requires": {
                "maximum": 4
              }
            }
          },
          "then": {
            "$ref": "#/$defs/titleBar"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "card"
              },
              "requires": {
                "maximum": 4
              }
            }
          },
          "then": {
            "$ref": "#/$defs/card"
          }
        }
      ]
    },
    "pageOverrides": {
      "description": "Per-page changes to elements, keyed by element ID. An ID that matches no element is a warning (ignored, kept).",
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "content": {
            "type": "object"
          },
          "style": {
            "type": "object"
          }
        }
      }
    },
    "titleBar": {
      "description": "Title bar (#79, feature level 2; docs/design/title-bar.md, ux.md §15). One per file, anchored top. Templates use {page}, {pageNumber}, {pageCount}, {time[:pattern]}, {date[:pattern]}; the token grammar is checked by the launcher and scripts/validate.py.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "id": true,
        "type": true,
        "requires": true,
        "enabled": {
          "type": "boolean"
        },
        "anchor": {
          "const": "top"
        },
        "content": {
          "$ref": "#/$defs/titleBarContent"
        },
        "style": {
          "$ref": "#/$defs/elementStyle"
        }
      }
    },
    "titleBarContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slots": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "$ref": "#/$defs/template"
            },
            "center": {
              "$ref": "#/$defs/template"
            },
            "end": {
              "$ref": "#/$defs/template"
            }
          }
        }
      }
    },
    "template": {
      "description": "One line, at most 120 characters, at most 8 tokens.",
      "type": "string",
      "maxLength": 120
    },
    "elementStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "oneOf": [
            {
              "enum": [
                "small",
                "medium",
                "large"
              ]
            },
            {
              "type": "number",
              "minimum": 10,
              "maximum": 40
            }
          ]
        },
        "weight": {
          "oneOf": [
            {
              "enum": [
                "regular",
                "medium",
                "bold"
              ]
            },
            {
              "enum": [
                300,
                400,
                500,
                600,
                700,
                800
              ]
            }
          ]
        },
        "color": {
          "oneOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "light": {
                  "$ref": "#/$defs/color"
                },
                "dark": {
                  "$ref": "#/$defs/color"
                }
              }
            }
          ]
        },
        "align": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "$ref": "#/$defs/align"
            },
            "center": {
              "$ref": "#/$defs/align"
            },
            "end": {
              "$ref": "#/$defs/align"
            }
          }
        },
        "padding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "horizontal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            },
            "vertical": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            }
          }
        },
        "backdrop": {
          "oneOf": [
            {
              "enum": [
                "auto",
                "none",
                "scrim"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "color"
              ],
              "properties": {
                "color": {
                  "$ref": "#/$defs/color"
                },
                "opacity": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "radius": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 24
                }
              }
            }
          ]
        }
      }
    },
    "color": {
      "oneOf": [
        {
          "enum": [
            "light",
            "dark",
            "onWallpaper",
            "primary",
            "secondary",
            "onSurface",
            "surface"
          ]
        },
        {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      ]
    },
    "align": {
      "enum": [
        "start",
        "center",
        "end"
      ]
    },
    "cardNode": {
      "description": "One node of a card layout (dynamic-widgets.md §1): containers column, row, tile (children, at most 4 levels deep) and primitives text, metric, list, icon, progress, button. No coordinates inside a card. Text fields are templates ({data:path}, {relative}, title-bar tokens), checked when cards render (S3-E/F).",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "children"
          ],
          "properties": {
            "type": {
              "const": "column"
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "weight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "tap": {
              "$ref": "#/$defs/cardTap"
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/cardNode"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "children"
          ],
          "properties": {
            "type": {
              "const": "row"
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "weight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "tap": {
              "$ref": "#/$defs/cardTap"
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/cardNode"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "children"
          ],
          "properties": {
            "type": {
              "const": "tile"
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "weight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "tap": {
              "$ref": "#/$defs/cardTap"
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/cardNode"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "weight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "tap": {
              "$ref": "#/$defs/cardTap"
            },
            "text": {
              "type": "string",
              "maxLength": 200
            },
            "role": {
              "enum": [
                "caption",
                "body",
                "title"
              ]
            },
            "maxLines": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "metric"
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "weight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "tap": {
              "$ref": "#/$defs/cardTap"
            },
            "label": {
              "type": "string",
              "maxLength": 40
            },
            "value": {
              "type": "string",
              "maxLength": 200
            },
            "unit": {
              "type": "string",
              "maxLength": 16
            },
            "status": {
              "type": "string",
              "maxLength": 200
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "const": "list"
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "weight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "tap": {
              "$ref": "#/$defs/cardTap"
            },
            "label": {
              "type": "string",
              "maxLength": 40
            },
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": {
              "oneOf": [
                {
                  "const": "auto"
                },
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                }
              ]
            },
            "emptyText": {
              "type": "string",
              "maxLength": 80
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "icon"
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "weight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "tap": {
              "$ref": "#/$defs/cardTap"
            },
            "name": {
              "type": "string",
              "maxLength": 64
            },
            "package": {
              "$ref": "#/$defs/packageName"
            }
          },
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "name"
              ],
              "not": {
                "required": [
                  "package"
                ]
              }
            },
            {
              "required": [
                "package"
              ],
              "not": {
                "required": [
                  "name"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "progress"
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "weight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "tap": {
              "$ref": "#/$defs/cardTap"
            },
            "label": {
              "type": "string",
              "maxLength": 40
            },
            "value": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "label",
            "tap"
          ],
          "properties": {
            "type": {
              "const": "button"
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "weight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "tap": {
              "$ref": "#/$defs/cardTap"
            },
            "label": {
              "type": "string",
              "maxLength": 40
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "cardTap": {
      "description": "A tap action; its kind (and package) must be declared in the card's capabilities. ui.openUrl to the card's source opens silently; any other host asks on every tap.",
      "type": "object",
      "required": [
        "kind"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "ui.openUrl"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "ui.openApp"
            },
            "package": {
              "$ref": "#/$defs/packageName"
            }
          },
          "required": [
            "kind",
            "package"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "ui.reload"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "card": {
      "description": "Dashboard card (#137 S3-A, feature level 4; docs/design/dynamic-widgets.md). Grid-placed, requires 4 or higher. Capabilities use the stage-3 kinds only: data.file (data is always .configlauncher/widgets-data/<id>.json), ui.reload, ui.openApp + packages, and a bare ui.openUrl (taps to source open silently; any other host asks on every tap). A launcher that doesn't know a kind skips the card with a warning; this schema (CI) rejects it so typos fail fast. Nothing renders yet.",
      "type": "object",
      "required": [
        "id",
        "type",
        "requires",
        "page",
        "x",
        "y",
        "w",
        "h",
        "layouts"
      ],
      "properties": {
        "id": {},
        "type": {
          "const": "card"
        },
        "requires": {
          "type": "integer",
          "minimum": 4
        },
        "page": {},
        "x": {},
        "y": {},
        "w": {},
        "h": {},
        "minSpan": {
          "type": "object",
          "required": [
            "w",
            "h"
          ],
          "properties": {
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          },
          "additionalProperties": false
        },
        "title": {
          "type": "string",
          "maxLength": 40
        },
        "author": {
          "description": "Who wrote it, quoted in the consent UI; never trusted. Omitted = hidden.",
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "source": {
          "description": "The card's own site (Q-D5): taps to it open without asking; any other host asks on every tap. Part of the consent fingerprint; not a fetch origin.",
          "type": "string",
          "maxLength": 261,
          "pattern": "^(https?://)?[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
        },
        "surface": {
          "const": "auto"
        },
        "capabilities": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "oneOf": [
              {
                "properties": {
                  "kind": {
                    "const": "data.file"
                  }
                },
                "additionalProperties": false
              },
              {
                "properties": {
                  "kind": {
                    "const": "ui.reload"
                  }
                },
                "additionalProperties": false
              },
              {
                "properties": {
                  "kind": {
                    "const": "ui.openApp"
                  },
                  "packages": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "uniqueItems": true,
                    "items": {
                      "$ref": "#/$defs/packageName"
                    }
                  }
                },
                "required": [
                  "packages"
                ],
                "additionalProperties": false
              },
              {
                "properties": {
                  "kind": {
                    "const": "ui.openUrl"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "data": {
          "type": "object",
          "properties": {
            "staleAfter": {
              "description": "ISO-8601 duration after which the card shows stale, e.g. PT30M.",
              "type": "string",
              "maxLength": 32,
              "pattern": "^P(?=[0-9]|T[0-9])([0-9]+D)?(T(?=[0-9])([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$"
            }
          },
          "additionalProperties": false
        },
        "layouts": {
          "description": "1-3 layouts keyed by size \"WxH\" (lowercase x); the launcher picks the largest that fits.",
          "type": "object",
          "minProperties": 1,
          "maxProperties": 3,
          "propertyNames": {
            "pattern": "^([1-9]|1[0-2])x([1-9]|1[0-2])$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "$ref": "#/$defs/cardNode"
            }
          }
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    }
  }
}
