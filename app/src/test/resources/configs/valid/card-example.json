{
  "schemaVersion": 1,
  "revision": 1,
  "grid": {
    "columns": 4,
    "rows": 5
  },
  "pages": [
    {
      "id": "home",
      "title": "Home",
      "items": [
        {
          "id": "a-settings",
          "type": "app",
          "package": "com.android.settings",
          "x": 0,
          "y": 0
        },
        {
          "id": "s-chrome-incognito",
          "type": "shortcut",
          "package": "com.android.chrome",
          "shortcutId": "incognito-tab",
          "label": "Incognito",
          "x": 1,
          "y": 0
        },
        {
          "id": "f-tools",
          "type": "folder",
          "label": "Tools",
          "items": [
            {
              "id": "a-calc",
              "type": "app",
              "package": "com.google.android.calculator"
            },
            {
              "id": "a-clock",
              "type": "app",
              "package": "com.google.android.deskclock",
              "activity": "com.android.deskclock.DeskClock"
            }
          ],
          "x": 2,
          "y": 0
        }
      ]
    }
  ],
  "dock": [
    {
      "id": "a-dialer",
      "type": "app",
      "package": "com.google.android.dialer"
    },
    {
      "id": "a-camera",
      "type": "app",
      "package": "com.android.camera2"
    }
  ],
  "drawer": {
    "sort": "label",
    "hidden": [],
    "rules": [
      {
        "id": "r-games",
        "group": "Games",
        "match": {
          "category": "game"
        }
      }
    ]
  },
  "elements": [
    {
      "id": "w-anigeek",
      "type": "card",
      "requires": 4,
      "page": "home",
      "x": 0,
      "y": 1,
      "w": 4,
      "h": 3,
      "layouts": {
        "2x1": [
          {
            "type": "metric",
            "label": "Monitors",
            "value": "{data:monitors.summary}",
            "status": "{data:monitors.status}"
          }
        ],
        "4x3": [
          {
            "type": "tile",
            "children": [
              {
                "type": "text",
                "role": "caption",
                "text": "Latest on blog.anigeek.com"
              },
              {
                "type": "text",
                "role": "body",
                "text": "{data:blog.title}",
                "maxLines": 2
              }
            ],
            "tap": {
              "kind": "ui.openUrl",
              "url": "{data:blog.url}"
            }
          },
          {
            "type": "row",
            "children": [
              {
                "type": "metric",
                "label": "PicSpin site",
                "value": "{data:picspin.value}",
                "status": "{data:picspin.status}"
              },
              {
                "type": "metric",
                "label": "letmeaithatforyou",
                "value": "{data:lmaitfy.value}",
                "priority": 4
              }
            ]
          },
          {
            "type": "list",
            "label": "Unhealthy monitors",
            "items": "{data:unhealthy}",
            "maxItems": "auto",
            "emptyText": "All monitors up"
          },
          {
            "type": "row",
            "children": [
              {
                "type": "button",
                "label": "Refresh",
                "tap": {
                  "kind": "ui.reload"
                }
              },
              {
                "type": "progress",
                "value": 0.5
              },
              {
                "type": "icon",
                "name": "cloud",
                "tap": {
                  "kind": "ui.openUrl",
                  "url": "https://status.example.org/"
                }
              }
            ]
          }
        ]
      },
      "minSpan": {
        "w": 3,
        "h": 2
      },
      "title": "Anigeek LLC",
      "author": "Claw",
      "source": "https://blog.anigeek.com",
      "surface": "auto",
      "capabilities": [
        {
          "kind": "data.file"
        },
        {
          "kind": "ui.openUrl"
        },
        {
          "kind": "ui.reload"
        }
      ],
      "data": {
        "staleAfter": "PT30M"
      }
    }
  ]
}
