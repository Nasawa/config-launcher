{
  "schemaVersion": 1,
  "revision": 1,
  "grid": {
    "columns": 4,
    "rows": 5
  },
  "pages": [
    {
      "id": "home",
      "title": "Home",
      "items": [
        {
          "id": "a-settings",
          "type": "app",
          "package": "com.android.settings",
          "x": 0,
          "y": 0
        },
        {
          "id": "s-chrome-incognito",
          "type": "shortcut",
          "package": "com.android.chrome",
          "shortcutId": "incognito-tab",
          "label": "Incognito",
          "x": 1,
          "y": 0
        },
        {
          "id": "f-tools",
          "type": "folder",
          "label": "Tools",
          "items": [
            {
              "id": "a-calc",
              "type": "app",
              "package": "com.google.android.calculator"
            },
            {
              "id": "a-clock",
              "type": "app",
              "package": "com.google.android.deskclock",
              "activity": "com.android.deskclock.DeskClock"
            }
          ],
          "x": 2,
          "y": 0
        }
      ],
      "overrides": {
        "t-main": {
          "content": {
            "slots": {
              "end": ""
            }
          },
          "style": {
            "size": "large"
          }
        }
      }
    }
  ],
  "dock": [
    {
      "id": "a-dialer",
      "type": "app",
      "package": "com.google.android.dialer"
    },
    {
      "id": "a-camera",
      "type": "app",
      "package": "com.android.camera2"
    }
  ],
  "drawer": {
    "sort": "label",
    "hidden": [],
    "rules": [
      {
        "id": "r-games",
        "group": "Games",
        "match": {
          "category": "game"
        }
      }
    ]
  },
  "elements": [
    {
      "x-note": "mine",
      "style": {
        "backdrop": {
          "radius": 12,
          "opacity": 35,
          "color": "#000000"
        },
        "padding": {
          "vertical": 6,
          "horizontal": 16
        },
        "align": {
          "end": "end",
          "start": "start"
        },
        "color": {
          "dark": "#F1F0F4",
          "light": "#1B1B1F"
        },
        "weight": 600,
        "size": 20
      },
      "content": {
        "slots": {
          "end": "{time:HH:mm}",
          "center": "{page} ({pageNumber}/{pageCount})",
          "start": "{date:EEE d MMM} {{x}} {time:h 'h' mm}"
        }
      },
      "anchor": "top",
      "enabled": true,
      "type": "titleBar",
      "id": "t-main"
    }
  ]
}
