    "1E+05",
    "0e0",
    "-0.0e-0",
    "1.5e10",
    "2.50E2",
    "12345678901234567890",
    "-12345678901234567890",
    "true",
    "false",
    "null"
  ],
  "reject": [
    "00",
    "01",
    "-00",
