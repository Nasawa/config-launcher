# Single source of truth for applicationId (PKG) and Kotlin namespace (NS) (#242 / #243).
# Shell:  source "$SCRIPT_DIR/pkg.env"
# Python: from pkg import PKG, NS, PKG_TAIL
#
# Component class names live under NS, not PKG. Always use "$PKG/$NS.MainActivity" /
# "$PKG/$NS.ReloadReceiver" (or broadcast -a "$PKG.RELOAD" -p "$PKG"). The shorthand
# form that puts a slash-dot after the applicationId expands to a class that does not exist.
PKG=com.anigeek.reflowlauncher
NS=dev.nasawa.configlauncher
