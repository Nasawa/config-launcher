# Single source of truth for the Android applicationId used by scripts and CI (#242).
# Shell:  source "$SCRIPT_DIR/pkg.env"
# Python: from pkg import PKG, PKG_TAIL
PKG=com.anigeek.reflowlauncher
# Kotlin namespace (#242: unchanged). Component class names live here, NOT under $PKG, so `$PKG/.MainActivity`
# expands to a class that does not exist. Use "$PKG/$NS.MainActivity" / "$PKG/$NS.ReloadReceiver". (QA: Grace)
NS=dev.nasawa.configlauncher
